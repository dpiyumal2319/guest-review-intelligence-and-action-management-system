# --- Database ---
# DATABASE_URL=postgresql+psycopg://guest_reviews:guest_reviews@localhost:5432/guest_reviews

# --- Issue detection LLM ---
# The issue pipeline (extract -> consolidate -> describe) uses an LLM.
#   LLM_PROVIDER=gemini  -> Google Gemini (default when GEMINI_API_KEY is set)
#   LLM_PROVIDER=stub    -> deterministic offline provider (no network, lower quality; for tests/dev)
# If unset: gemini when GEMINI_API_KEY exists, otherwise stub.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Cap how many negative/mixed reviews are sent to the LLM per detection run (cost control).
# ISSUE_MAX_REVIEWS=1000
# How many reviews per extraction call.
# ISSUE_LLM_BATCH_SIZE=8
